def test_build_table1a_columns(subjects_df: pd.DataFrame) -> None:
    out = build_table1a(subjects_df)
    assert set(out.columns) >= {"level", "pct_classified", "n", "share", "indent"}


def test_build_table1a_profession_adds_professor_row(subjects_df: pd.DataFrame) -> None:
    out = build_table1a(subjects_df)
    assert "Professor" in out[out["variable"] == "profession"]["level"].tolist()


def test_build_table1b_columns(scrambled_df: pd.DataFrame) -> None:
    out = build_table1b(scrambled_df)
    assert set(out.columns) == {"variable", "mean", "sd", "median", "min", "max", "n"}


@pytest.mark.parametrize("stat", ["mean", "sd", "median", "min", "max"])
def test_build_table1b_stats_are_numeric(scrambled_df: pd.DataFrame, stat: str) -> None:
    out = build_table1b(scrambled_df)
    assert pd.to_numeric(out[stat], errors="coerce").notna().all()
